<Window x:Class="LabelFlowStudio.Desktop.ManualWeightInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Требуется вес"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="14"
        ShowInTaskbar="False">
    <Border Style="{StaticResource CardStyle}" Margin="16" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Вес короба не получен"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding PromptMessage}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock Text="Вес брутто, кг"
                           Margin="0,0,0,6"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="WeightTextBox"
                         Height="38"
                         VerticalContentAlignment="Center"
                         PreviewTextInput="WeightTextBox_PreviewTextInput"
                         PreviewKeyDown="WeightTextBox_PreviewKeyDown"
                         DataObject.Pasting="WeightTextBox_Pasting"/>
                <TextBlock Text="Допустимы только цифры и точка (например: 5.155)."
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <DockPanel Grid.Row="2" Margin="0,18,0,0" LastChildFill="False">
                <Button Content="Сохранить вес"
                        MinWidth="150"
                        Height="36"
                        Click="SaveButton_Click"
                        Style="{StaticResource ToolbarPrimaryButtonStyle}"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
