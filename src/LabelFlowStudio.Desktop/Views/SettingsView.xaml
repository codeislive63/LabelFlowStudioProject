<UserControl x:Class="LabelFlowStudio.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LabelFlowStudio.Desktop.Views"
             Loaded="OnLoaded">
    <Grid Margin="{DynamicResource ShellPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="SettingsScrollViewer"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="{StaticResource SettingsEditorMaxWidth}"
                        HorizontalAlignment="Center">
                <TextBlock Margin="{StaticResource SettingsMarginBottom8}"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Text="Настройки" />

                <views:PrintSettingsEditorView DataContext="{Binding Editor}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Margin="{StaticResource SettingsMarginTop12}"
                Padding="{StaticResource SettingsFooterPadding}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid MaxWidth="{StaticResource SettingsEditorMaxWidth}"
                  HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ErrorBrush}"
                           Text="{Binding InlineErrorMessage}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasInlineError}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button MinWidth="{StaticResource SettingsCancelButtonWidth}"
                            Height="{StaticResource SettingsControlHeight}"
                            Margin="0,0,12,0"
                            Command="{Binding CancelCommand}"
                            Content="Отменить изменения"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button MinWidth="{StaticResource SettingsSaveButtonWidth}"
                            Height="{StaticResource SettingsControlHeight}"
                            Command="{Binding SaveCommand}"
                            Content="Сохранить"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
