<UserControl x:Class="LabelFlowStudio.Desktop.Views.Work.WorkSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModels="clr-namespace:LabelFlowStudio.Desktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
             d:DesignHeight="760"
             d:DesignWidth="1200"
             mc:Ignorable="d"
             Loaded="WorkSectionView_Loaded"
             IsVisibleChanged="WorkSectionView_IsVisibleChanged">
    <Grid Margin="{DynamicResource ShellPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding SwitchToAutomaticModeCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource WorkModeButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAutomaticMode}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Pipeline24" Margin="0,0,8,0" />
                        <TextBlock Text="Автоматическая линия" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding SwitchToManualModeCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource WorkModeButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAutomaticMode}" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="HandLeft24" Margin="0,0,8,0" />
                        <TextBlock Text="Ручная обработка" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="12,7"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Записей" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Records.Count}" Margin="8,0,0,0" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Automatic and manual are two states of Work, never simultaneous screens. -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Border Padding="18"
                    BorderBrush="#C9D8F8"
                    Background="#F4F7FE">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAutomaticMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource AccentBrush}">
                        <ui:SymbolIcon Symbol="Pipeline24"
                                       Foreground="White"
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Автоматический режим выбран"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Padding="14">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAutomaticMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="TENAM"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontWeight="SemiBold" />

                    <TextBox x:Name="TenamTextBox"
                             Grid.Column="1"
                             Style="{StaticResource AppTextBoxStyle}"
                             Text="{Binding Tenam, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="TenamTextBox_PreviewTextInput"
                             PreviewKeyDown="TenamTextBox_PreviewKeyDown"
                             DataObject.Pasting="TenamTextBox_Pasting"
                             GotKeyboardFocus="TenamTextBox_GotKeyboardFocus" />

                    <Button Grid.Column="2"
                            Style="{StaticResource WorkActionButtonStyle}"
                            Command="{Binding OpenEndLabelPreviewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BarcodeScanner24" Margin="0,0,7,0" />
                            <TextBlock Text="Торцевая этикетка" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3"
                            Style="{StaticResource WorkActionButtonStyle}"
                            Command="{Binding OpenStuffingSheetPreviewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Print24" Margin="0,0,7,0" />
                            <TextBlock Text="Лист сброса" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4"
                            Style="{StaticResource WorkActionButtonStyle}"
                            Command="{Binding RequestManualWeightCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚖" Margin="0,0,7,0" />
                            <TextBlock Text="Ввести вес" />
                        </StackPanel>
                    </Button>

                    <CheckBox Grid.Row="1"
                              Grid.Column="1"
                              Grid.ColumnSpan="5"
                              Margin="0,10,0,0"
                              HorizontalAlignment="Left"
                              Content="Печатать торцевую этикетку сразу после ручного сканирования"
                              IsChecked="{Binding IsManualScanAutoPrintEndLabelEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Статус" Margin="0,0,10,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding LastProcessedTenam}"
                           Margin="16,0,0,0"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="20"
                           FontWeight="Bold" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <DataGrid x:Name="RecordsGrid"
                          ItemsSource="{Binding Records}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserSortColumns="True"
                          LoadingRow="RecordsGrid_LoadingRow"
                          Sorting="RecordsGrid_Sorting"
                          ColumnHeaderHeight="40"
                          RowHeight="34"
                          GridLinesVisibility="Horizontal"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource AppDataGridStyle}">
                            <Setter Property="RowHeaderWidth" Value="44" />
                            <Setter Property="HeadersVisibility" Value="All" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Records.Count}" Value="0">
                                    <Setter Property="RowHeaderWidth" Value="0" />
                                    <Setter Property="HeadersVisibility" Value="Column" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.Resources>
                        <Style x:Key="CellTextStyle" TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="TextWrapping" Value="NoWrap" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="10,0" />
                            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TENAM" Binding="{Binding Tenam}" Width="110" ElementStyle="{StaticResource CellTextStyle}" />
                        <DataGridTextColumn Header="Код магазина" Binding="{Binding Lfaempfkdnr}" Width="140" ElementStyle="{StaticResource CellTextStyle}" />
                        <DataGridTextColumn Header="Короб в заказе" Binding="{Binding Tesortnr}" Width="100" ElementStyle="{StaticResource CellTextStyle}" />
                        <DataGridTextColumn Header="Артикул" Binding="{Binding Artnr}" Width="160" ElementStyle="{StaticResource CellTextStyle}" />
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Artbez}" Width="260" ElementStyle="{StaticResource CellTextStyle}" />
                        <DataGridTextColumn Header="Кол-во в коробе" Binding="{Binding Bstmg}" Width="120" ElementStyle="{StaticResource CellTextStyle}" />
                        <DataGridTextColumn Header="Код заказа" Binding="{Binding Bstchgnam5}" Width="300" ElementStyle="{StaticResource CellTextStyle}" />
                        <DataGridTextColumn Header="AUFID" Binding="{Binding Aufid}" Width="190" ElementStyle="{StaticResource CellTextStyle}" />
                        <DataGridTextColumn Header="Код заказа (LFAKDNR)" Binding="{Binding Lfakdnr}" Width="160" ElementStyle="{StaticResource CellTextStyle}" />
                        <DataGridTextColumn Header="Город" Binding="{Binding Lfaempfort1}" Width="160" ElementStyle="{StaticResource CellTextStyle}" />
                        <DataGridTextColumn Header="Улица" Binding="{Binding Lfaempfstrasse}" Width="220" ElementStyle="{StaticResource CellTextStyle}" />
                        <DataGridTextColumn Header="Грузополучатель" Binding="{Binding Gpbez}" Width="260" ElementStyle="{StaticResource CellTextStyle}" />
                        <DataGridTextColumn Header="Индекс" Binding="{Binding Gpplz}" Width="90" ElementStyle="{StaticResource CellTextStyle}" />
                        <DataGridTextColumn Header="Страна" Binding="{Binding Lndnam}" Width="80" ElementStyle="{StaticResource CellTextStyle}" />
                        <DataGridTextColumn Header="Город (GP)" Binding="{Binding Gport1}" Width="140" ElementStyle="{StaticResource CellTextStyle}" />
                        <DataGridTextColumn Header="Улица (GP)" Binding="{Binding Gpstrasse}" Width="220" ElementStyle="{StaticResource CellTextStyle}" />
                        <DataGridTextColumn Header="Адрес строкой" Binding="{Binding Adres}" Width="280" ElementStyle="{StaticResource CellTextStyle}" />
                        <DataGridTextColumn Header="Изделий в коробе" Binding="{Binding SumBst}" Width="140" ElementStyle="{StaticResource CellTextStyle}" />
                        <DataGridTextColumn Header="Вес брутто, кг" Binding="{Binding Brutto}" Width="120" ElementStyle="{StaticResource CellTextStyle}" />
                        <DataGridTextColumn Header="Маркет" Binding="{Binding Market}" Width="90" ElementStyle="{StaticResource CellTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Records.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ui:SymbolIcon Symbol="BarcodeScanner24" FontSize="32" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="Ожидание сканирования TENAM"
                               Margin="0,10,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="16"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.RowSpan="4" Panel.ZIndex="90" IsHitTestVisible="False">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource AppBackgroundBrush}" Opacity="0.72" />
            <Border Style="{StaticResource CardStyle}"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="90" Height="6" IsIndeterminate="True" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" Margin="14,0,0,0" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
