<UserControl x:Class="LabelFlowStudio.Desktop.Views.Work.WorkModeSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModels="clr-namespace:LabelFlowStudio.Desktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
             d:DesignHeight="42"
             d:DesignWidth="440"
             mc:Ignorable="d">
    <Border MaxWidth="440"
            Padding="4"
            HorizontalAlignment="Left"
            Background="{DynamicResource SurfaceAltBrush}"
            BorderBrush="{DynamicResource SurfaceBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="214" />
                <ColumnDefinition Width="214" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    AutomationProperties.Name="Переключить на автоматическую линию"
                    Command="{Binding SwitchToAutomaticModeCommand}">
                <Button.Style>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource AutoLineModeSegmentButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAutomaticMode}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AutoLineBlueBorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AutoLineBlueBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock VerticalAlignment="Center"
                           FontSize="12"
                           Text="Автоматический режим" />
            </Button>

            <Button Grid.Column="1"
                    AutomationProperties.Name="Переключить на ручную обработку"
                    Command="{Binding SwitchToManualModeCommand}">
                <Button.Style>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource AutoLineModeSegmentButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAutomaticMode}" Value="False">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AutoLineBlueBorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AutoLineBlueBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock VerticalAlignment="Center"
                           FontSize="12"
                           Text="Ручная обработка" />
            </Button>
        </Grid>
    </Border>
</UserControl>
