<UserControl x:Class="LabelFlowStudio.Desktop.Views.Work.AutomaticLineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModels="clr-namespace:LabelFlowStudio.Desktop.ViewModels"
             xmlns:work="clr-namespace:LabelFlowStudio.Desktop.Views.Work"
             d:DataContext="{d:DesignInstance Type=viewModels:AutomaticLineViewModel}"
             d:DesignHeight="760"
             d:DesignWidth="1200"
             mc:Ignorable="d"
             Loaded="AutomaticLineView_Loaded"
             Unloaded="AutomaticLineView_Unloaded">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Margin="{DynamicResource AutoLinePagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <work:WorkModeSelector Grid.Row="0"
                                   Margin="0,0,0,16"
                                   DataContext="{Binding Work}" />

            <!-- Main line state. Idle is deliberately blue/neutral; green is reserved
                 for a confirmed successful processing result. -->
            <Border Grid.Row="1"
                    Margin="0,0,0,12">
                <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource AutoLineCardStyle}">
                        <Setter Property="MinHeight" Value="142" />
                        <Setter Property="Padding" Value="24" />
                        <Setter Property="Background" Value="{StaticResource AutoLineBlueSoftBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource AutoLineBlueBorderBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LineState}"
                                         Value="{x:Static viewModels:AutomaticLineState.Success}">
                                <Setter Property="Background" Value="{StaticResource AutoLineSuccessSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AutoLineSuccessBorderBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LineState}"
                                         Value="{x:Static viewModels:AutomaticLineState.Warning}">
                                <Setter Property="Background" Value="{StaticResource AutoLineWarningSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AutoLineWarningBorderBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LineState}"
                                         Value="{x:Static viewModels:AutomaticLineState.Error}">
                                <Setter Property="Background" Value="{StaticResource AutoLineErrorSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AutoLineErrorBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid AutomationProperties.LiveSetting="Polite">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="64"
                            Height="64"
                            VerticalAlignment="Center"
                            CornerRadius="32">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AutoLineBlueBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LineState}"
                                                 Value="{x:Static viewModels:AutomaticLineState.Success}">
                                        <Setter Property="Background" Value="{StaticResource AutoLineSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LineState}"
                                                 Value="{x:Static viewModels:AutomaticLineState.Warning}">
                                        <Setter Property="Background" Value="{StaticResource AutoLineWarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LineState}"
                                                 Value="{x:Static viewModels:AutomaticLineState.Error}">
                                        <Setter Property="Background" Value="{StaticResource AutoLineErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ui:SymbolIcon HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="30"
                                       Foreground="White">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="Pipeline24" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LineState}"
                                                     Value="{x:Static viewModels:AutomaticLineState.Loading}">
                                            <Setter Property="Symbol" Value="DocumentArrowDown24" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LineState}"
                                                     Value="{x:Static viewModels:AutomaticLineState.Processing}">
                                            <Setter Property="Symbol" Value="ArrowSync24" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LineState}"
                                                     Value="{x:Static viewModels:AutomaticLineState.Printing}">
                                            <Setter Property="Symbol" Value="Print24" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LineState}"
                                                     Value="{x:Static viewModels:AutomaticLineState.Success}">
                                            <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LineState}"
                                                     Value="{x:Static viewModels:AutomaticLineState.Warning}">
                                            <Setter Property="Symbol" Value="Warning24" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LineState}"
                                                     Value="{x:Static viewModels:AutomaticLineState.Error}">
                                            <Setter Property="Symbol" Value="ErrorCircle24" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="24,0"
                                VerticalAlignment="Center">
                        <TextBlock FontSize="25"
                                   FontWeight="SemiBold"
                                   Text="{Binding LineHeadline, FallbackValue=Линия работает}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LineState}"
                                                     Value="{x:Static viewModels:AutomaticLineState.Success}">
                                            <Setter Property="Foreground" Value="{StaticResource AutoLineSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LineState}"
                                                     Value="{x:Static viewModels:AutomaticLineState.Warning}">
                                            <Setter Property="Foreground" Value="{StaticResource AutoLineWarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LineState}"
                                                     Value="{x:Static viewModels:AutomaticLineState.Error}">
                                            <Setter Property="Foreground" Value="{StaticResource AutoLineErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding LineSubtitle, FallbackValue=Ожидание следующего короба}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            VerticalAlignment="Top"
                            Style="{StaticResource AutoLineStatusPillStyle}">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource AutoLineBlueBrush}" />
                                    <Setter Property="Text" Value="ОЖИДАНИЕ" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LineState}"
                                                     Value="{x:Static viewModels:AutomaticLineState.Loading}">
                                            <Setter Property="Text" Value="ЗАГРУЗКА" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LineState}"
                                                     Value="{x:Static viewModels:AutomaticLineState.Processing}">
                                            <Setter Property="Text" Value="ОБРАБОТКА" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LineState}"
                                                     Value="{x:Static viewModels:AutomaticLineState.Printing}">
                                            <Setter Property="Text" Value="ПЕЧАТЬ" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LineState}"
                                                     Value="{x:Static viewModels:AutomaticLineState.Success}">
                                            <Setter Property="Text" Value="УСПЕХ" />
                                            <Setter Property="Foreground" Value="{StaticResource AutoLineSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LineState}"
                                                     Value="{x:Static viewModels:AutomaticLineState.Warning}">
                                            <Setter Property="Text" Value="ВНИМАНИЕ" />
                                            <Setter Property="Foreground" Value="{StaticResource AutoLineWarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LineState}"
                                                     Value="{x:Static viewModels:AutomaticLineState.Error}">
                                            <Setter Property="Text" Value="ОШИБКА" />
                                            <Setter Property="Foreground" Value="{StaticResource AutoLineErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- Last processed box. All values come from the current-run projection. -->
            <Border Grid.Row="2"
                    Margin="0,0,0,12"
                    Padding="16,12"
                    Style="{StaticResource AutoLineCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="42"
                            Height="42"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource AutoLineBlueSoftBrush}"
                            CornerRadius="10">
                        <ui:SymbolIcon HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="22"
                                       Foreground="{StaticResource AutoLineBlueBrush}"
                                       Symbol="Cube24" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource AutoLineMutedTextStyle}"
                                   Text="Последний короб" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding LastBoxTenamText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource AutoLineMutedTextStyle}"
                                   Text="Время" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding LastBoxTimeText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource AutoLineMutedTextStyle}"
                                   Text="Результат" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding LastBoxResultText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4"
                                Margin="12,0,12,0"
                                VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource AutoLineMutedTextStyle}"
                                   Text="Выполненное действие" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding LastBoxActionText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding LastBoxActionText}" />
                    </StackPanel>

                    <Border Grid.Column="5"
                            MinWidth="86"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border"
                                   BasedOn="{StaticResource AutoLineStatusPillStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLastBoxSuccess}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AutoLineSuccessSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AutoLineSuccessBorderBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLastBoxWarning}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AutoLineWarningSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AutoLineWarningBorderBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLastBoxError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AutoLineErrorSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AutoLineErrorBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource AutoLineNeutralBrush}" />
                                    <Setter Property="Text" Value="Нет данных" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLastBoxSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AutoLineSuccessBrush}" />
                                            <Setter Property="Text" Value="Успешно" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLastBoxWarning}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AutoLineWarningBrush}" />
                                            <Setter Property="Text" Value="Внимание" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLastBoxError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AutoLineErrorBrush}" />
                                            <Setter Property="Text" Value="Ошибка" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- KPI sources are intentionally absent in this change-set. -->
            <Grid Grid.Row="3" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,12,0"
                        Style="{StaticResource AutoLineKpiCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Margin="0,0,16,0"
                                       FontSize="24"
                                       Foreground="{StaticResource AutoLineBlueBrush}"
                                       Symbol="Clock24" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource AutoLineMutedTextStyle}" Text="За смену" />
                            <TextBlock Margin="0,8,0,0" FontSize="23" FontWeight="SemiBold" Text="–" />
                            <TextBlock Style="{StaticResource AutoLineMutedTextStyle}" Text="Нет данных" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Margin="0,0,12,0"
                        Style="{StaticResource AutoLineKpiCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Margin="0,0,16,0"
                                       FontSize="24"
                                       Foreground="{StaticResource AutoLineNeutralBrush}"
                                       Symbol="CheckmarkCircle24" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource AutoLineMutedTextStyle}" Text="Успешно" />
                            <TextBlock Margin="0,8,0,0" FontSize="23" FontWeight="SemiBold" Text="–" />
                            <TextBlock Style="{StaticResource AutoLineMutedTextStyle}" Text="Нет данных" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Margin="0,0,12,0"
                        Style="{StaticResource AutoLineKpiCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Margin="0,0,16,0"
                                       FontSize="24"
                                       Foreground="{StaticResource AutoLineNeutralBrush}"
                                       Symbol="ErrorCircle24" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource AutoLineMutedTextStyle}" Text="Ошибки" />
                            <TextBlock Margin="0,8,0,0" FontSize="23" FontWeight="SemiBold" Text="–" />
                            <TextBlock Style="{StaticResource AutoLineMutedTextStyle}" Text="Нет данных" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="3"
                        Style="{StaticResource AutoLineKpiCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Margin="0,0,16,0"
                                       FontSize="24"
                                       Foreground="{StaticResource AutoLineBlueBrush}"
                                       Symbol="Gauge24" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource AutoLineMutedTextStyle}" Text="Скорость" />
                            <TextBlock Margin="0,8,0,0" FontSize="23" FontWeight="SemiBold" Text="–" />
                            <TextBlock Style="{StaticResource AutoLineMutedTextStyle}" Text="Нет данных" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,12,0"
                        Style="{StaticResource AutoLineCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource AutoLineSectionTitleStyle}"
                                   Text="Состояние оборудования" />

                        <UniformGrid Grid.Row="1"
                                     Margin="0,12,0,0"
                                     Columns="2"
                                     Rows="2">
                            <Border Margin="0,0,8,8"
                                    Style="{StaticResource AutoLineEquipmentItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                     <Ellipse Width="9" Height="9" Margin="0,0,12,0" VerticalAlignment="Center">
                                         <Ellipse.Style>
                                             <Style TargetType="Ellipse">
                                                 <Setter Property="Fill" Value="{StaticResource AutoLineNeutralBrush}" />
                                                 <Style.Triggers>
                                                     <DataTrigger Binding="{Binding HasEquipmentSnapshot}" Value="True">
                                                         <Setter Property="Fill" Value="{StaticResource AutoLineErrorBrush}" />
                                                     </DataTrigger>
                                                     <DataTrigger Binding="{Binding IsScannerRunning}" Value="True">
                                                         <Setter Property="Fill" Value="{StaticResource AutoLineSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Сканер" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Style="{StaticResource AutoLineMutedTextStyle}"
                                                   Text="{Binding ScannerStatusText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Margin="8,0,0,8"
                                    Style="{StaticResource AutoLineEquipmentItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9"
                                             Height="9"
                                             Margin="0,0,12,0"
                                             VerticalAlignment="Center"
                                             Fill="{StaticResource AutoLineNeutralBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="WMS/Oracle" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Style="{StaticResource AutoLineMutedTextStyle}"
                                                   Text="{Binding WmsStatusText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Margin="0,8,8,0"
                                    Style="{StaticResource AutoLineEquipmentItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                     <Ellipse Width="9" Height="9" Margin="0,0,12,0" VerticalAlignment="Center">
                                         <Ellipse.Style>
                                             <Style TargetType="Ellipse">
                                                 <Setter Property="Fill" Value="{StaticResource AutoLineNeutralBrush}" />
                                                 <Style.Triggers>
                                                     <DataTrigger Binding="{Binding HasEquipmentSnapshot}" Value="True">
                                                         <Setter Property="Fill" Value="{StaticResource AutoLineErrorBrush}" />
                                                     </DataTrigger>
                                                     <DataTrigger Binding="{Binding IsPrinterInstalled}" Value="True">
                                                         <Setter Property="Fill" Value="{StaticResource AutoLineBlueBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Принтер" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Style="{StaticResource AutoLineMutedTextStyle}"
                                                   Text="{Binding PrinterStatusText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Margin="8,8,0,0"
                                    Style="{StaticResource AutoLineEquipmentItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource AutoLineNeutralBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsScalesEnabled}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource AutoLineBlueBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Весы" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Style="{StaticResource AutoLineMutedTextStyle}"
                                                   Text="{Binding ScalesStatusText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource AutoLineCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource AutoLineSectionTitleStyle}"
                                       Text="Последние события" />
                            <Button Grid.Column="1"
                                    Command="{Binding DataContext.NavigateToJournalCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    Style="{StaticResource AutoLineLinkButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Открыть журнал" />
                                    <TextBlock Margin="8,0,0,0" Text="→" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ItemsControl Grid.Row="1"
                                      Margin="0,8,0,0"
                                      ItemsSource="{Binding RecentEvents}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRecentEvents}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:AutomaticLineEvent}">
                                    <Border Style="{StaticResource AutoLineEventItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" />
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe UI Symbol"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding CategoryIcon}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource AutoLineNeutralBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AutoLineSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AutoLineWarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AutoLineErrorBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Text="{Binding Message}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Message}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Grid.Row="1"
                                   Margin="0,16,0,8"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="Событий текущего запуска пока нет">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource AutoLineMutedTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRecentEvents}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
