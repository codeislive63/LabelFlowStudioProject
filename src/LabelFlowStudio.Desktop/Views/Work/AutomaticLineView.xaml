<UserControl x:Class="LabelFlowStudio.Desktop.Views.Work.AutomaticLineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModels="clr-namespace:LabelFlowStudio.Desktop.ViewModels"
             xmlns:work="clr-namespace:LabelFlowStudio.Desktop.Views.Work"
             d:DataContext="{d:DesignInstance Type=viewModels:AutomaticLineViewModel}"
             d:DesignHeight="780"
             d:DesignWidth="1200"
             mc:Ignorable="d"
             Loaded="AutomaticLineView_Loaded"
             Unloaded="AutomaticLineView_Unloaded">
    <ScrollViewer HorizontalContentAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid x:Name="AutomaticLineContent"
              MaxWidth="1320"
              Margin="{DynamicResource AutoLinePagePadding}"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <work:WorkModeSelector Grid.Row="0"
                                   Margin="{StaticResource WorkGapBottom16}"
                                   DataContext="{Binding Work}" />

            <!-- The center card reflects only the real projected line state. -->
            <Border Grid.Row="1"
                    MinHeight="142"
                    Margin="{StaticResource WorkGapBottom12}"
                    Padding="24,18">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AutoLineCardStyle}">
                        <Setter Property="Background" Value="{StaticResource AutoLineNeutralSoftBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource AutoLineNeutralBorderBrush}" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Idle}" />
                                    <Condition Binding="{Binding HasEquipmentSnapshot}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{StaticResource AutoLineSuccessSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AutoLineSuccessBorderBrush}" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Initializing}">
                                <Setter Property="Background" Value="{StaticResource AutoLineBlueSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AutoLineBlueBorderBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Loading}">
                                <Setter Property="Background" Value="{StaticResource AutoLineBlueSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AutoLineBlueBorderBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Processing}">
                                <Setter Property="Background" Value="{StaticResource AutoLineBlueSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AutoLineBlueBorderBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Printing}">
                                <Setter Property="Background" Value="{StaticResource AutoLineBlueSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AutoLineBlueBorderBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Success}">
                                <Setter Property="Background" Value="{StaticResource AutoLineSuccessSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AutoLineSuccessBorderBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Warning}">
                                <Setter Property="Background" Value="{StaticResource AutoLineWarningSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AutoLineWarningBorderBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Error}">
                                <Setter Property="Background" Value="{StaticResource AutoLineErrorSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AutoLineErrorBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite">
                    <Border Width="54" Height="54" HorizontalAlignment="Center" CornerRadius="27">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AutoLineNeutralBrush}" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Idle}" />
                                            <Condition Binding="{Binding HasEquipmentSnapshot}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{StaticResource AutoLineSuccessBrush}" />
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Initializing}">
                                        <Setter Property="Background" Value="{StaticResource AutoLineBlueBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Loading}">
                                        <Setter Property="Background" Value="{StaticResource AutoLineBlueBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Processing}">
                                        <Setter Property="Background" Value="{StaticResource AutoLineBlueBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Printing}">
                                        <Setter Property="Background" Value="{StaticResource AutoLineBlueBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Success}">
                                        <Setter Property="Background" Value="{StaticResource AutoLineSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Warning}">
                                        <Setter Property="Background" Value="{StaticResource AutoLineWarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Error}">
                                        <Setter Property="Background" Value="{StaticResource AutoLineErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ui:SymbolIcon HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="28"
                                       Foreground="White">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="Pipeline24" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Idle}" />
                                                <Condition Binding="{Binding HasEquipmentSnapshot}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Initializing}">
                                            <Setter Property="Symbol" Value="ArrowSync24" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Loading}">
                                            <Setter Property="Symbol" Value="DocumentArrowDown24" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Processing}">
                                            <Setter Property="Symbol" Value="ArrowSync24" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Printing}">
                                            <Setter Property="Symbol" Value="Print24" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Success}">
                                            <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Warning}">
                                            <Setter Property="Symbol" Value="Warning24" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Error}">
                                            <Setter Property="Symbol" Value="ErrorCircle24" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Border>

                    <TextBlock Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Text="{Binding LineHeadline, FallbackValue=Линия работает}"
                               TextAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource AutoLineNeutralBrush}" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Idle}" />
                                            <Condition Binding="{Binding HasEquipmentSnapshot}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="{StaticResource AutoLineSuccessBrush}" />
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Initializing}">
                                        <Setter Property="Foreground" Value="{StaticResource AutoLineBlueBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Loading}">
                                        <Setter Property="Foreground" Value="{StaticResource AutoLineBlueBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Processing}">
                                        <Setter Property="Foreground" Value="{StaticResource AutoLineBlueBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Printing}">
                                        <Setter Property="Foreground" Value="{StaticResource AutoLineBlueBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Success}">
                                        <Setter Property="Foreground" Value="{StaticResource AutoLineSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Warning}">
                                        <Setter Property="Foreground" Value="{StaticResource AutoLineWarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LineState}" Value="{x:Static viewModels:AutomaticLineState.Error}">
                                        <Setter Property="Foreground" Value="{StaticResource AutoLineErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               MaxWidth="720"
                               Text="{Binding LineSubtitle, FallbackValue=Ожидание следующего короба}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- One event-shaped card replaces the former four-field form row. -->
            <Border Grid.Row="2"
                    MinHeight="76"
                    Margin="{StaticResource WorkGapBottom12}"
                    Padding="14,12">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AutoLineCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLastBoxSuccess}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AutoLineSuccessSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AutoLineSuccessBorderBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLastBoxWarning}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AutoLineWarningSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AutoLineWarningBorderBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLastBoxError}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AutoLineErrorSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AutoLineErrorBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLastBox}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="42"
                                Height="42"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Background="{StaticResource AutoLineBlueSoftBrush}"
                                CornerRadius="10">
                            <ui:SymbolIcon HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="22"
                                           Foreground="{StaticResource AutoLineBlueBrush}"
                                           Symbol="Cube24" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="15" FontWeight="SemiBold">
                                <Run Text="Последний короб " />
                                <Run Text="{Binding LastBoxTenamText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,5,16,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding LastBoxActionText}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding LastBoxActionText}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    MinWidth="96"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Right"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding LastBoxTimeText}" />
                            <Border Margin="0,6,0,0" HorizontalAlignment="Right">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource AutoLineStatusPillStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLastBoxSuccess}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AutoLineSuccessSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AutoLineSuccessBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLastBoxWarning}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AutoLineWarningSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AutoLineWarningBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLastBoxError}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AutoLineErrorSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AutoLineErrorBorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding LastBoxResultText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource AutoLineNeutralBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLastBoxSuccess}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AutoLineSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLastBoxWarning}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AutoLineWarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLastBoxError}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AutoLineErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLastBox}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Последний обработанный короб пока отсутствует" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- KPI sources do not exist yet: all four cards deliberately stay unavailable. -->
            <Grid Grid.Row="3" Margin="{StaticResource WorkGapBottom12}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="{StaticResource WorkGapRight12}" Style="{StaticResource AutoLineKpiCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource AutoLineKpiIconHostStyle}">
                            <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="21" Foreground="{StaticResource AutoLineNeutralBrush}" Symbol="CalendarClock24" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource AutoLineMutedTextStyle}" Text="За смену" />
                            <TextBlock Margin="0,3,0,0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AutoLineNeutralBrush}" Text="–" />
                            <TextBlock Style="{StaticResource AutoLineMutedTextStyle}" Text="Нет данных" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Margin="{StaticResource WorkGapRight12}" Style="{StaticResource AutoLineKpiCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource AutoLineKpiIconHostStyle}">
                            <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="21" Foreground="{StaticResource AutoLineNeutralBrush}" Symbol="CheckmarkCircle24" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource AutoLineMutedTextStyle}" Text="Успешно" />
                            <TextBlock Margin="0,3,0,0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AutoLineNeutralBrush}" Text="–" />
                            <TextBlock Style="{StaticResource AutoLineMutedTextStyle}" Text="Нет данных" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Margin="{StaticResource WorkGapRight12}" Style="{StaticResource AutoLineKpiCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource AutoLineKpiIconHostStyle}">
                            <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="21" Foreground="{StaticResource AutoLineNeutralBrush}" Symbol="ErrorCircle24" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource AutoLineMutedTextStyle}" Text="Ошибки" />
                            <TextBlock Margin="0,3,0,0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AutoLineNeutralBrush}" Text="–" />
                            <TextBlock Style="{StaticResource AutoLineMutedTextStyle}" Text="Нет данных" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource AutoLineKpiCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource AutoLineKpiIconHostStyle}">
                            <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="21" Foreground="{StaticResource AutoLineNeutralBrush}" Symbol="Gauge24" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource AutoLineMutedTextStyle}" Text="Скорость" />
                            <TextBlock Margin="0,3,0,0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AutoLineNeutralBrush}" Text="–" />
                            <TextBlock Style="{StaticResource AutoLineMutedTextStyle}" Text="Нет данных" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="4"
                    Margin="{StaticResource WorkGapBottom12}"
                    Style="{StaticResource AutoLineCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource AutoLineSectionTitleStyle}" Text="Состояние оборудования" />

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="{StaticResource WorkGapRight12}" Style="{StaticResource AutoLineEquipmentItemStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource AutoLineEquipmentIconHostStyle}">
                                    <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{StaticResource AutoLineNeutralBrush}" Symbol="BarcodeScanner24" />
                                </Border>
                                <Ellipse Grid.Column="1" Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource AutoLineNeutralBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasEquipmentSnapshot}" Value="True"><Setter Property="Fill" Value="{StaticResource AutoLineErrorBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IsScannerRunning}" Value="True"><Setter Property="Fill" Value="{StaticResource AutoLineSuccessBrush}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="Сканер" />
                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource AutoLineMutedTextStyle}" Text="{Binding ScannerStatusText}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="DatabaseEquipmentCard"
                                Grid.Column="1"
                                Margin="{StaticResource WorkGapRight12}"
                                Style="{StaticResource AutoLineEquipmentItemStyle}"
                                ToolTip="{Binding OracleStatusToolTip}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource AutoLineEquipmentIconHostStyle}">
                                    <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{StaticResource AutoLineNeutralBrush}" Symbol="Database24" />
                                </Border>
                                <Ellipse x:Name="DatabaseStatusDot"
                                         Grid.Column="1"
                                         Width="9"
                                         Height="9"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource AutoLineNeutralBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOracleStatusChecking}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AutoLineBlueBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOracleStatusConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AutoLineSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOracleStatusError}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AutoLineErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="База данных" />
                                    <TextBlock x:Name="DatabaseStatusText"
                                               Margin="0,3,0,0"
                                               Style="{StaticResource AutoLineMutedTextStyle}"
                                               Text="{Binding OracleStatusText}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Margin="{StaticResource WorkGapRight12}" Style="{StaticResource AutoLineEquipmentItemStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource AutoLineEquipmentIconHostStyle}">
                                    <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{StaticResource AutoLineNeutralBrush}" Symbol="Print24" />
                                </Border>
                                <Ellipse Grid.Column="1" Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource AutoLineNeutralBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasEquipmentSnapshot}" Value="True"><Setter Property="Fill" Value="{StaticResource AutoLineWarningBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IsPrinterInstalled}" Value="True"><Setter Property="Fill" Value="{StaticResource AutoLineSuccessBrush}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="Принтер" />
                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource AutoLineMutedTextStyle}" Text="{Binding PrinterStatusText}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource AutoLineEquipmentItemStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource AutoLineEquipmentIconHostStyle}">
                                    <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{StaticResource AutoLineNeutralBrush}" Symbol="Scales24" />
                                </Border>
                                <Ellipse Grid.Column="1" Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource AutoLineNeutralBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScalesEnabled}" Value="True"><Setter Property="Fill" Value="{StaticResource AutoLineBlueBrush}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="Весы" />
                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource AutoLineMutedTextStyle}" Text="{Binding ScalesStatusText}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="5" Style="{StaticResource AutoLineCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource AutoLineSectionTitleStyle}" Text="Последние события" />
                        <Button Grid.Column="1"
                                Command="{Binding DataContext.NavigateToJournalCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                Style="{StaticResource AutoLineLinkButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Открыть журнал" />
                                <TextBlock Margin="8,0,0,0" Text="→" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ItemsControl Grid.Row="1"
                                  Margin="0,8,0,0"
                                  ClipToBounds="True"
                                  ItemsSource="{Binding RecentEvents}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecentEvents}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:AutomaticLineEvent}">
                                <Border Style="{StaticResource AutoLineEventItemStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Top"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Top"
                                                   FontFamily="Segoe UI Symbol"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding CategoryIcon}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource AutoLineNeutralBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="True"><Setter Property="Foreground" Value="{StaticResource AutoLineSuccessBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True"><Setter Property="Foreground" Value="{StaticResource AutoLineWarningBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource AutoLineErrorBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2"
                                                   FontSize="12"
                                                   LineHeight="16"
                                                   MaxHeight="32"
                                                   Text="{Binding Message}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap"
                                                   ToolTip="{Binding Message}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="1"
                               Margin="0,16,0,8"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="Событий текущего запуска пока нет">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource AutoLineMutedTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecentEvents}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
