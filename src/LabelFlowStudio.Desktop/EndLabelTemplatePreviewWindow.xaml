<Window x:Class="LabelFlowStudio.Desktop.EndLabelTemplatePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Торцевая этикетка"
        Height="820"
        Width="1280"
        MinHeight="650"
        MinWidth="1000"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="14"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                        CornerRadius="0"
                        ResizeBorderThickness="8"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Placement" Value="Mouse"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,6">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewModeToggleStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                Margin="2"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorOptionStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="16,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PreviewToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="{DynamicResource ShellHeaderBrush}"    
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,0,0,1">

            <ui:TitleBar
                Height="44"
                Title="Редактор торцевой этикетки"
                ShowMinimize="True"
                ShowMaximize="True"
                ShowClose="True"
                CanMaximize="True"
                Background="{DynamicResource ShellHeaderBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                ButtonsForeground="{DynamicResource TextPrimaryBrush}"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ViewPreviewMenuItem"
                                     GroupName="TemplateViewMode"
                                     Content="Preview"
                                     Style="{StaticResource ViewModeToggleStyle}"
                                     Click="OnViewModeMenuClick"/>
                        <RadioButton x:Name="ViewSplitMenuItem"
                                     GroupName="TemplateViewMode"
                                     Content="Split"
                                     Style="{StaticResource ViewModeToggleStyle}"
                                     Click="OnViewModeMenuClick"/>
                        <RadioButton x:Name="ViewCodeMenuItem"
                                     GroupName="TemplateViewMode"
                                     Content="Code"
                                     Style="{StaticResource ViewModeToggleStyle}"
                                     Click="OnViewModeMenuClick"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="10,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <CheckBox x:Name="ShowBoundsMenuItem"
                              Content="Границы"
                              IsChecked="True"
                              Style="{StaticResource EditorOptionStyle}"
                              Checked="OnEditorFlagsChanged"
                              Unchecked="OnEditorFlagsChanged"/>
                    <CheckBox x:Name="ShowGridMenuItem"
                              Content="Сетка"
                              IsChecked="False"
                              Style="{StaticResource EditorOptionStyle}"
                              Checked="OnEditorFlagsChanged"
                              Unchecked="OnEditorFlagsChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Импорт"
                            ToolTip="Ctrl+O"
                            Click="OnImportClick"
                            Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="Экспорт"
                            ToolTip="Ctrl+E"
                            Click="OnExportClick"
                            Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="Сохранить"
                            ToolTip="Ctrl+S"
                            Click="OnSaveClick"
                            Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="Печать"
                            ToolTip="Ctrl+P"
                            Click="OnPrintClick"
                            Style="{StaticResource PrimaryToolbarButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="16"
                Padding="8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="EditorColumn" Width="0"/>
                    <ColumnDefinition x:Name="SplitterColumn" Width="0"/>
                    <ColumnDefinition x:Name="PreviewColumn" Width="*"/>
                    <ColumnDefinition x:Name="ToolsColumn" Width="Auto"/>
                </Grid.ColumnDefinitions>

                <wv2:WebView2 x:Name="EditorWebView"
                              Grid.Column="0"
                              Focusable="True"/>

                <GridSplitter x:Name="MainSplitter"
                              Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{DynamicResource SurfaceBorderBrush}"/>

                <Grid x:Name="PreviewHost"
                      Grid.Column="2"
                      Margin="0,0,4,0"
                      Background="{DynamicResource SurfaceBrush}">
                    <wv2:WebView2 x:Name="PreviewWebView"
                                  NavigationCompleted="OnPreviewNavigationCompleted"
                                  PreviewMouseWheel="OnPreviewMouseWheel"/>
                </Grid>

                <Border x:Name="PreviewToolsPanel"
                        Grid.Column="3"
                        Width="58"
                        Padding="8"
                        Margin="0,0,2,16"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Visibility="Visible">
                    <StackPanel>
                        <Button Content="−"
                                ToolTip="Уменьшить"
                                Click="OnZoomOutClick"
                                Style="{StaticResource PreviewToolButtonStyle}"/>
                        <Button Content="+"
                                ToolTip="Увеличить"
                                Click="OnZoomInClick"
                                Style="{StaticResource PreviewToolButtonStyle}"/>
                        <Button ToolTip="1:1"
                                Click="OnZoomResetClick"
                                Style="{StaticResource PreviewToolButtonStyle}">
                            <TextBlock Text="1:1" FontWeight="SemiBold"/>
                        </Button>
                        <TextBlock x:Name="ZoomText"
                                   Margin="0,2,0,0"
                                   Text="100%"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ToastPanel"
                        Panel.ZIndex="200"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,18"
                        Padding="14,10"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="10" Opacity="0.18"/>
                    </Border.Effect>
                    <TextBlock x:Name="ToastText"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
