<Window x:Class="LabelFlowStudio.Desktop.EndLabelTemplatePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Торцевая этикетка"
        Height="800"
        Width="1200"
        MinHeight="650"
        MinWidth="1000"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="14"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="0"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Tooltip -->
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Placement" Value="Mouse"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,6">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VS-like menu -->
        <Style x:Key="VsMenuStyle" TargetType="Menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="VsMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="VsMenuDropItemStyle" TargetType="MenuItem">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Window buttons -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preview tools -->
        <Style x:Key="PreviewToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Menu -->
                <Menu Grid.Column="0" Style="{StaticResource VsMenuStyle}">
                    <MenuItem Header="Файл" Style="{StaticResource VsMenuItemStyle}">
                        <MenuItem Header="Импорт"
                                  Style="{StaticResource VsMenuDropItemStyle}"
                                  Click="OnImportClick"
                                  InputGestureText="Ctrl+O"/>
                        <MenuItem Header="Экспорт"
                                  Style="{StaticResource VsMenuDropItemStyle}"
                                  Click="OnExportClick"
                                  InputGestureText="Ctrl+E"/>
                        <Separator/>
                        <MenuItem Header="Печать"
                                  Style="{StaticResource VsMenuDropItemStyle}"
                                  Click="OnPrintClick"
                                  InputGestureText="Ctrl+P"/>
                    </MenuItem>

                    <MenuItem Header="Вид" Style="{StaticResource VsMenuItemStyle}">
                        <MenuItem x:Name="ViewPreviewMenuItem"
                                  Header="Preview"
                                  IsCheckable="True"
                                  Click="OnViewModeMenuClick"/>
                        <MenuItem x:Name="ViewSplitMenuItem"
                                  Header="Split"
                                  IsCheckable="True"
                                  Click="OnViewModeMenuClick"/>
                        <MenuItem x:Name="ViewCodeMenuItem"
                                  Header="Code"
                                  IsCheckable="True"
                                  Click="OnViewModeMenuClick"/>
                    </MenuItem>

                    <MenuItem Header="Редактор" Style="{StaticResource VsMenuItemStyle}">
                        <MenuItem x:Name="ShowBoundsMenuItem"
                                  Header="Показать границы"
                                  IsCheckable="True"
                                  IsChecked="True"
                                  Style="{StaticResource VsMenuDropItemStyle}"
                                  Checked="OnEditorFlagsChanged"
                                  Unchecked="OnEditorFlagsChanged"/>
                        <MenuItem x:Name="ShowGridMenuItem"
                                  Header="Показать сетку"
                                  IsCheckable="True"
                                  IsChecked="False"
                                  Style="{StaticResource VsMenuDropItemStyle}"
                                  Checked="OnEditorFlagsChanged"
                                  Unchecked="OnEditorFlagsChanged"/>
                    </MenuItem>
                </Menu>

                <!-- Window buttons -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="OnMinimizeClick" ToolTip="Свернуть">
                        <TextBlock Text="—" FontSize="14" FontWeight="Bold"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="OnMaximizeRestoreClick" ToolTip="Развернуть">
                        <TextBlock Text="▢" FontSize="13" FontWeight="Bold"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="OnCloseClick" ToolTip="Закрыть">
                        <TextBlock Text="✕" FontSize="13" FontWeight="Bold"/>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- CONTENT -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="16" Padding="0">
            <Grid Background="{DynamicResource SurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="EditorColumn" Width="0"/>
                    <ColumnDefinition x:Name="SplitterColumn" Width="0"/>
                    <ColumnDefinition x:Name="PreviewColumn" Width="*"/>
                    <ColumnDefinition x:Name="ToolsColumn" Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Editor -->
                <wv2:WebView2 x:Name="EditorWebView" Grid.Column="0" Focusable="True" />

                <GridSplitter x:Name="MainSplitter"
                              Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{DynamicResource SurfaceBorderBrush}"/>

                <!-- Preview -->
                <Grid x:Name="PreviewHost" Margin="0,0,12,0" Grid.Column="2" Background="{DynamicResource SurfaceBrush}">
                    <wv2:WebView2 x:Name="PreviewWebView"
                                  NavigationCompleted="OnPreviewNavigationCompleted"
                                  PreviewMouseWheel="OnPreviewMouseWheel"/>
                </Grid>

                <!-- Preview tools -->
                <Border x:Name="PreviewToolsPanel"
                        Grid.Column="3"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Right"
                        Margin="0,0,10,40"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="10"
                        Width="65"
                        Visibility="Visible">
                    <StackPanel>
                        <Button Style="{StaticResource PreviewToolButtonStyle}"
                                ToolTip="Уменьшить"
                                Click="OnZoomOutClick"
                                Content="−"/>

                        <Button Style="{StaticResource PreviewToolButtonStyle}"
                                ToolTip="Увеличить"
                                Click="OnZoomInClick"
                                Content="+"/>

                        <Button Style="{StaticResource PreviewToolButtonStyle}"
                                ToolTip="1:1"
                                Click="OnZoomResetClick">
                            <TextBlock Text="1:1"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>

                        <Border Margin="0,2,0,0"
                                Background="Transparent"
                                CornerRadius="10"
                                Padding="6,4">
                            <TextBlock x:Name="ZoomText"
                                       Text="100%"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Toast -->
                <Border x:Name="ToastPanel"
                        Panel.ZIndex="200"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,18"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="10" Opacity="0.18"/>
                    </Border.Effect>

                    <TextBlock x:Name="ToastText"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Border>

            </Grid>
        </Border>

    </Grid>
</Window>
