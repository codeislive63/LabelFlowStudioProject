<Window x:Class="LabelFlowStudio.Desktop.EndLabelTemplatePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Торцевая этикетка"
        Height="800"
        Width="1200"
        MinHeight="650"
        MinWidth="1000"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="14">

    <DockPanel Margin="16" LastChildFill="True">

        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Print / Save / Status / Close -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="PrintButton"
                                Width="140"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnPrintClick"
                                IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE749;"
                                           FontSize="16"
                                           Margin="0,0,8,0"
                                           Foreground="White"/>
                                <TextBlock Text="Печать" Foreground="White"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="SaveButton"
                                Width="140"
                                Margin="10,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnSaveClick"
                                IsEnabled="False"
                                Content="Сохранить"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,7"
                            Margin="12,0">
                        <TextBlock x:Name="StatusText"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>

                    <Button Grid.Column="2"
                            Width="140"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="OnCloseClick"
                            Content="Закрыть" />
                </Grid>

                <!-- Row 1: Modes / Preview toggles / Zoom -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <RadioButton x:Name="ModeCode"
                                     Content="Код"
                                     Margin="0,0,10,0"/>
                        <RadioButton x:Name="ModeSplit"
                                     Content="Код + предпросмотр"
                                     Margin="0,0,10,0"/>
                        <RadioButton x:Name="ModePreview"
                                     Content="Предпросмотр"
                                     IsChecked="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                        <CheckBox x:Name="ShowBoundsCheckBox"
                                  Content="Границы"
                                  IsChecked="True"
                                  Checked="OnPreviewFlagsChanged"
                                  Unchecked="OnPreviewFlagsChanged"
                                  Margin="0,0,12,0"/>
                        <CheckBox x:Name="ShowGridCheckBox"
                                  Content="Сетка"
                                  IsChecked="False"
                                  Checked="OnPreviewFlagsChanged"
                                  Unchecked="OnPreviewFlagsChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Width="38" Style="{StaticResource SecondaryButtonStyle}" Click="OnZoomOutClick" Content="−"/>
                        <Border Width="70"
                                Margin="10,0"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,7">
                            <TextBlock x:Name="ZoomText" Text="100%" HorizontalAlignment="Center"/>
                        </Border>
                        <Button Width="38" Style="{StaticResource SecondaryButtonStyle}" Click="OnZoomInClick" Content="+"/>
                        <Button Width="90" Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="OnZoomResetClick" Content="100%"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <Border Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="EditorColumn" Width="*"/>
                    <ColumnDefinition x:Name="SplitterColumn" Width="6"/>
                    <ColumnDefinition x:Name="PreviewColumn" Width="*"/>
                </Grid.ColumnDefinitions>

                <wv2:WebView2 x:Name="EditorWebView" Grid.Column="0"/>

                <GridSplitter Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{DynamicResource SurfaceBorderBrush}"/>

                <wv2:WebView2 x:Name="PreviewWebView"
                             Grid.Column="2"
                             NavigationCompleted="OnNavigationCompleted"
                             PreviewMouseWheel="OnPreviewMouseWheel"/>
            </Grid>
        </Border>

    </DockPanel>
</Window>
