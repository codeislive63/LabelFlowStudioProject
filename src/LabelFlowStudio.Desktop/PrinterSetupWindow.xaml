<Window x:Class="LabelFlowStudio.Desktop.Printing.PrinterSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка печати"
        Width="620"
        Height="420"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="SetupCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="SetupComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Border Style="{DynamicResource CardStyle}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock x:Name="StepText"
                               FontSize="13"
                               Opacity="0.8"
                               Text="Шаг 1 из 2"/>
                    <TextBlock x:Name="TitleText"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0"
                               Text="Выберите принтер для торцевых этикеток"/>
                    <TextBlock x:Name="SubtitleText"
                               FontSize="13"
                               Opacity="0.85"
                               Margin="0,6,0,0"
                               Text="Параметры можно поменять в меню: Печать → Настройки печати"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <CheckBox x:Name="PrintEndLabelCheckBox"
                              Style="{StaticResource SetupCheckBoxStyle}"
                              Content="Печатать торцевую этикетку"
                              Checked="OnPrintEndLabelChecked"
                              Unchecked="OnPrintEndLabelChecked"/>
                    <CheckBox x:Name="PrintStuffingSheetCheckBox"
                              Style="{StaticResource SetupCheckBoxStyle}"
                              Content="Печатать лист сброса"
                              Checked="OnPrintStuffingSheetChecked"
                              Unchecked="OnPrintStuffingSheetChecked"/>
                    <CheckBox x:Name="UseScalesCheckBox"
                              Style="{StaticResource SetupCheckBoxStyle}"
                              Margin="0"
                              Content="Использовать весы"
                              Checked="OnUseScalesChecked"
                              Unchecked="OnUseScalesChecked"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Opacity="0.85" Text="Принтер"/>
                    <ComboBox x:Name="PrintersComboBox"
                              Style="{StaticResource SetupComboBoxStyle}"
                              Margin="0,10,0,0"/>
                    <TextBlock x:Name="ValidationText"
                               Visibility="Collapsed"
                               Foreground="{DynamicResource ErrorBrush}"
                               Margin="0,8,0,0"
                               Text="Нужно выбрать принтер"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Opacity="0.85" Text="Копий торцевой этикетки"/>
                            <TextBox x:Name="EndLabelCopiesTextBox"
                                     Margin="0,8,0,0"
                                     Padding="10,6"
                                     MinHeight="38"
                                     Text="2"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Opacity="0.85" Text="Копий листа сброса"/>
                            <TextBox x:Name="StuffingSheetCopiesTextBox"
                                     Margin="0,8,0,0"
                                     Padding="10,6"
                                     MinHeight="38"
                                     Text="1"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="ManualScanAutoPrintEndLabelCheckBox"
                              Style="{StaticResource SetupCheckBoxStyle}"
                              Margin="0,12,0,0"
                              Content="Полуавтомат торцевой этикетки (скан → печать)"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            MinWidth="114"
                            MinHeight="38"
                            Padding="16,8"
                            Margin="0,0,10,0"
                            Content="Назад"
                            Click="OnBackClick" Height="44"/>
                    <Button x:Name="NextButton"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            MinWidth="114"
                            MinHeight="38"
                            Padding="16,8"
                            Content="Далее"
                            Foreground="White"
                            Click="OnNextClick" Height="44"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
