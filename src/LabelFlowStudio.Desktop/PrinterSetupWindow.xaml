<Window x:Class="LabelFlowStudio.Desktop.Printing.PrinterSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка печати"
        Width="560"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="16">
        <Border Style="{DynamicResource CardStyle}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock x:Name="StepText"
                               FontSize="13"
                               Opacity="0.8"
                               Text="Шаг 1 из 2"/>
                    <TextBlock x:Name="TitleText"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0"
                               Text="Выберите принтер для торцевых этикеток"/>
                    <TextBlock x:Name="SubtitleText"
                               FontSize="13"
                               Opacity="0.85"
                               Margin="0,6,0,0"
                               Text="*Этот параметр можно поменять в настройках печати"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <CheckBox x:Name="PrintEndLabelCheckBox"
                              Content="Печатать торцевую этикетку"
                              VerticalAlignment="Center"
                              Margin="0,0,18,0"
                              Checked="OnPrintEndLabelChecked"
                              Unchecked="OnPrintEndLabelChecked"/>
                    <CheckBox x:Name="PrintStuffingSheetCheckBox"
                              Content="Печатать лист сброса"
                              VerticalAlignment="Center"
                              Checked="OnPrintStuffingSheetChecked"
                              Unchecked="OnPrintStuffingSheetChecked"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <TextBlock FontSize="13" Opacity="0.85" Text="Принтер"/>
                    <ComboBox x:Name="PrintersComboBox"
                              MinHeight="34"
                              Margin="0,6,0,0"/>
                    <TextBlock x:Name="ValidationText"
                               Visibility="Collapsed"
                               Foreground="{DynamicResource ErrorBrush}"
                               Margin="0,8,0,0"
                               Text="Нужно выбрать принтер"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            MinWidth="114"
                            MinHeight="38"
                            Padding="16,8"
                            Margin="0,0,10,0"
                            Content="Назад"
                            Click="OnBackClick" Height="44"/>
                    <Button x:Name="NextButton"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            MinWidth="114"
                            MinHeight="38"
                            Padding="16,8"
                            Content="Далее"
                            Foreground="White"
                            Click="OnNextClick" Height="44"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
