<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <Thickness x:Key="SettingsSpace24">24</Thickness>
    <Thickness x:Key="SettingsMarginBottom8">0,0,0,8</Thickness>
    <Thickness x:Key="SettingsMarginBottom12">0,0,0,12</Thickness>
    <Thickness x:Key="SettingsMarginBottom16">0,0,0,16</Thickness>
    <Thickness x:Key="SettingsMarginRight8">0,0,8,0</Thickness>
    <Thickness x:Key="SettingsMarginLeft8">8,0,0,0</Thickness>
    <Thickness x:Key="SettingsMarginTop8">0,8,0,0</Thickness>
    <Thickness x:Key="SettingsMarginTop12">0,12,0,0</Thickness>
    <Thickness x:Key="SettingsFieldPadding">11,8</Thickness>
    <Thickness x:Key="SettingsFooterPadding">16,12,0,0</Thickness>
    <CornerRadius x:Key="SettingsCardCornerRadius">12</CornerRadius>
    <system:Double x:Key="SettingsControlHeight">40</system:Double>
    <system:Double x:Key="SettingsStatusDotSize">8</system:Double>
    <system:Double x:Key="SettingsCopiesControlWidth">136</system:Double>
    <system:Double x:Key="SettingsCancelButtonWidth">150</system:Double>
    <system:Double x:Key="SettingsSaveButtonWidth">120</system:Double>
    <system:Double x:Key="SettingsEditorMaxWidth">1040</system:Double>

    <Style x:Key="SettingsCardStyle"
           TargetType="Border"
           BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="{StaticResource SettingsSpace24}" />
        <Setter Property="CornerRadius" Value="{StaticResource SettingsCardCornerRadius}" />
    </Style>

    <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="{StaticResource SettingsMarginBottom8}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="SettingsValidationTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="{StaticResource SettingsMarginBottom8}" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SettingsPrinterStatusTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="{StaticResource SettingsControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource SettingsFieldPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
</ResourceDictionary>
