<ui:FluentWindow x:Class="LabelFlowStudio.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="LabelFlowStudio"
                 Width="1280"
                 Height="820"
                 MinWidth="1040"
                 MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource AppBackgroundBrush}"
                 Loaded="MainWindow_Loaded"
                 GotKeyboardFocus="Window_GotKeyboardFocus"
                 PreviewTextInput="Window_PreviewTextInput"
                 PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="LabelFlowStudio"
                     CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Cube24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border Grid.Row="1"
                Background="{DynamicResource ShellHeaderBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource ShellNavigationToggleStyle}"
                                 GroupName="AppSections"
                                 IsChecked="{Binding IsWorkSectionOpen, Mode=OneWay}"
                                 Command="{Binding NavigateToWorkCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Pipeline24" Margin="0,0,7,0" />
                            <TextBlock Text="Работа" FontWeight="SemiBold" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ShellNavigationToggleStyle}"
                                 GroupName="AppSections"
                                 IsChecked="{Binding IsJournalSectionOpen, Mode=OneWay}"
                                 Command="{Binding NavigateToJournalCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="History24" Margin="0,0,7,0" />
                            <TextBlock Text="Журнал" FontWeight="SemiBold" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ShellNavigationToggleStyle}"
                                 GroupName="AppSections"
                                 IsChecked="{Binding IsSettingsSectionOpen, Mode=OneWay}"
                                 Command="{Binding NavigateToSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,7,0" />
                            <TextBlock Text="Настройки" FontWeight="SemiBold" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ShellIconButtonStyle}"
                            Margin="0,0,10,0"
                            ToolTip="Настройки печати"
                            Click="OnOpenPrintSettingsClick">
                        <ui:SymbolIcon Symbol="Print24" />
                    </Button>

                    <Button x:Name="NotificationCenterButton"
                            Style="{StaticResource ShellIconButtonStyle}"
                            ToolTip="Уведомления"
                            Click="NotificationCenterButton_Click">
                        <Grid>
                            <ui:SymbolIcon Symbol="Alert24" />
                            <Border MinWidth="18"
                                    Height="18"
                                    Padding="4,0"
                                    Margin="0,-9,-12,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    CornerRadius="9"
                                    Background="{Binding Work.NotificationBadgeColor}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Work.UnreadNotificationsCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Work.UnreadNotificationsCount}"
                                           Foreground="{Binding Work.NotificationBadgeTextColor}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Row="2"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Content="{Binding CurrentSectionViewModel}" />

        <Popup x:Name="NotificationCenterPopup"
               PlacementTarget="{Binding ElementName=NotificationCenterButton}"
               Placement="Bottom"
               HorizontalOffset="-350"
               VerticalOffset="8"
               AllowsTransparency="True"
               StaysOpen="False"
               IsOpen="{Binding Work.IsNotificationCenterOpen, Mode=TwoWay}"
               Closed="NotificationCenterPopup_Closed">
            <Border Width="390"
                    MaxHeight="560"
                    Padding="14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" Opacity="0.18" ShadowDepth="4" />
                </Border.Effect>
                <Grid DataContext="{Binding Work}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="Уведомления" FontSize="18" FontWeight="SemiBold" />
                        <Button HorizontalAlignment="Right"
                                Width="30"
                                Height="30"
                                Content="×"
                                Style="{StaticResource ShellIconButtonStyle}"
                                Click="NotificationCenterCloseButton_Click" />
                    </Grid>

                    <ComboBox Grid.Row="1"
                              Margin="0,12,0,10"
                              SelectedIndex="{Binding NotificationTabIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Все уведомления" />
                        <ComboBoxItem Content="Ошибки" />
                        <ComboBoxItem Content="Предупреждения" />
                        <ComboBoxItem Content="Успешные операции" />
                    </ComboBox>

                    <ListBox Grid.Row="2"
                             MinHeight="180"
                             MaxHeight="330"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemsSource="{Binding FilteredNotificationsView}"
                             SelectedItem="{Binding SelectedNotification, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NotificationListItemStyle}"
                             SelectionChanged="NotificationsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding CategoryIcon}" FontSize="16" Margin="0,1,9,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding CategoryText}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Message}"
                                                   Margin="0,3,0,0"
                                                   MaxHeight="42"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11" />
                                        <Ellipse Width="7" Height="7" Margin="0,8,0,0"
                                                 HorizontalAlignment="Right"
                                                 Fill="{DynamicResource AccentBrush}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3"
                            Margin="0,10,0,0"
                            Padding="10"
                            Background="{DynamicResource SurfaceAltBrush}"
                            CornerRadius="8">
                        <TextBlock Text="{Binding SelectedNotification.Message, TargetNullValue=Выберите уведомление для просмотра подробностей.}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</ui:FluentWindow>
