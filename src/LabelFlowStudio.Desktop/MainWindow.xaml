<Window x:Class="LabelFlowStudio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:LabelFlowStudio.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Title="LabelFlowStudio"
        Height="700"
        Width="1200"
        MinHeight="600"
        MinWidth="900"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="14"
        Loaded="MainWindow_Loaded"
        PreviewTextInput="Window_PreviewTextInput"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,12">
            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="TENAM"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="TenamTextBox"
                         Grid.Column="1"
                         Style="{StaticResource AppTextBoxStyle}"
                         Text="{Binding Tenam, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,12,0"
                         PreviewTextInput="TenamTextBox_PreviewTextInput"
                         PreviewKeyDown="TenamTextBox_PreviewKeyDown"
                         DataObject.Pasting="TenamTextBox_Pasting"
                         GotKeyboardFocus="TenamTextBox_GotKeyboardFocus">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding LoadRecordsCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="2"
                        Style="{StaticResource ToolbarSecondaryButtonStyle}"
                        Content="Торцевая этикетка"
                        Command="{Binding OpenEndLabelPreviewCommand}"
                        Margin="0,0,10,0"/>

                <Button Grid.Column="3"
                        Style="{StaticResource ToolbarSecondaryButtonStyle}"
                        Content="Лист сброса"
                        Command="{Binding OpenStuffingSheetPreviewCommand}" />
            </Grid>
        </Border>

        <!-- Статус + центрированный TENAM + счётчик -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая часть: статус -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Статус"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Центр: последний успешный TENAM -->
                <TextBlock Grid.Column="1"
                           Text="{Binding LastProcessedTenam}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Opacity="0.70"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LastProcessedTenam}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Правая часть: записи -->
                <Border Grid.Column="2"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,6"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Записей:"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Records.Count}"
                                   Margin="8,0,0,0"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Таблица -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <DataGrid x:Name="RecordsGrid"
          ItemsSource="{Binding Records}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          CanUserSortColumns="True"
          LoadingRow="RecordsGrid_LoadingRow"
          Sorting="RecordsGrid_Sorting"
          HeadersVisibility="All"
          ColumnHeaderHeight="40"
          RowHeaderWidth="44"
          RowHeight="34"
          GridLinesVisibility="Horizontal"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Auto"
          EnableRowVirtualization="True"
          EnableColumnVirtualization="True">

                    <DataGrid.Resources>
                        <Style x:Key="CellTextStyle" TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="TextWrapping" Value="NoWrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="10,0,10,0"/>
                            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>

                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="10,0,10,0"/>
                        </Style>

                        <!-- ✅ Все DataGridTextColumn автоматически получают один стиль -->
                        <Style TargetType="{x:Type DataGridTextColumn}">
                            <Setter Property="ElementStyle" Value="{StaticResource CellTextStyle}"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.RowHeaderStyle>
                        <Style TargetType="{x:Type DataGridRowHeader}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGrid.RowHeaderStyle>

                    <DataGrid.Columns>
                        <!-- Идентификаторы -->
                        <DataGridTextColumn Header="TENAM" Binding="{Binding Tenam}" Width="110" />
                        <DataGridTextColumn Header="Код магазина" Binding="{Binding Lfaempfkdnr}" Width="140" />
                        <DataGridTextColumn Header="Короб в заказе" Binding="{Binding Tesortnr}" Width="80" />

                        <!-- Товар -->
                        <DataGridTextColumn Header="Артикул" Binding="{Binding Artnr}" Width="160" />
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Artbez}" Width="260" />
                        <DataGridTextColumn Header="Кол-во в коробе" Binding="{Binding Bstmg}" Width="110" />

                        <!-- Заказ -->
                        <DataGridTextColumn Header="Код заказа" Binding="{Binding Bstchgnam5}" Width="320" />
                        <DataGridTextColumn Header="AUFID" Binding="{Binding Aufid}" Width="190" />
                        <DataGridTextColumn Header="Код заказа (LFAKDNR)" Binding="{Binding Lfakdnr}" Width="150" />

                        <!-- Адрес доставки (что печатается как DeliveryCity/DeliveryStreet) -->
                        <DataGridTextColumn Header="Город" Binding="{Binding Lfaempfort1}" Width="160" />
                        <DataGridTextColumn Header="Улица" Binding="{Binding Lfaempfstrasse}" Width="220" />

                        <!-- Грузополучатель (название/организация) -->
                        <DataGridTextColumn Header="Грузополучатель" Binding="{Binding Gpbez}" Width="260" />

                        <!-- Адрес грузополучателя (если нужно смотреть “как пришло из SAP/Oracle”) -->
                        <DataGridTextColumn Header="Индекс" Binding="{Binding Gpplz}" Width="90" />
                        <DataGridTextColumn Header="Страна" Binding="{Binding Lndnam}" Width="70" />
                        <DataGridTextColumn Header="Город (GP)" Binding="{Binding Gport1}" Width="140" />
                        <DataGridTextColumn Header="Улица (GP)" Binding="{Binding Gpstrasse}" Width="220" />
                        <DataGridTextColumn Header="Адрес строкой" Binding="{Binding Adres}" Width="280" />

                        <!-- KPI -->
                        <DataGridTextColumn Header="Изделий в коробе" Binding="{Binding SumBst}" Width="140" />
                        <DataGridTextColumn Header="Вес брутто, кг" Binding="{Binding Brutto}" Width="120" />
                        <DataGridTextColumn Header="Маркет" Binding="{Binding Market}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state, когда данных нет -->
                <Grid Panel.ZIndex="5" IsHitTestVisible="False">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Records.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <TextBlock Text="Ожидание сканирования TENAM"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Opacity="0.85"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Уголок "№" (показываем только когда есть строки) -->
                <Border Panel.ZIndex="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Width="{Binding ElementName=RecordsGrid, Path=RowHeaderWidth}"
                        Height="{Binding ElementName=RecordsGrid, Path=ColumnHeaderHeight}"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                        BorderThickness="0,0,1,1"
                        IsHitTestVisible="False">

                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Records.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock Text="№"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Busy overlay -->
        <Grid Grid.RowSpan="3" Panel.ZIndex="100" IsHitTestVisible="True">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{DynamicResource AppBackgroundBrush}" Opacity="0.65"/>

            <Border Style="{StaticResource CardStyle}"
                    Padding="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="28" Height="28" Margin="0,0,12,0">
                        <Ellipse Width="26"
                                 Height="26"
                                 Stroke="{DynamicResource SurfaceBorderBrush}"
                                 StrokeThickness="4"
                                 Opacity="0.55"/>

                        <Path x:Name="SpinnerArc"
                              Data="M 13,1 A 12,12 0 0 1 25,13"
                              Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Path.RenderTransform>
                        </Path>

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SpinnerArc"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:0.9"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
