<Window x:Class="LabelFlowStudio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:LabelFlowStudio.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Title="LabelFlowStudio"
        Height="700"
        Width="1200"
        MinHeight="600"
        MinWidth="900"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,12">
            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="TENAM"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="TenamTextBox"
                         Grid.Column="1"
                         Style="{StaticResource AppTextBoxStyle}"
                         Text="{Binding Tenam, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,12,0"
                         PreviewTextInput="TenamTextBox_PreviewTextInput"
                         PreviewKeyDown="TenamTextBox_PreviewKeyDown"
                         DataObject.Pasting="TenamTextBox_Pasting">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding LoadRecordsCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="2"
                    Style="{StaticResource ToolbarSecondaryButtonStyle}"
                    Content="Загрузить"
                    Command="{Binding LoadRecordsCommand}"
                    Margin="0,0,10,0" />

                <Button Grid.Column="3"
                    Style="{StaticResource ToolbarSecondaryButtonStyle}"
                    Content="Торцевая этикетка"
                    Command="{Binding OpenEndLabelPreviewCommand}"
                    Margin="0,0,10,0"/>

                 <Button Grid.Column="4"
                    Style="{StaticResource ToolbarSecondaryButtonStyle}"
                    Content="Лист сброса"
                    Command="{Binding OpenStuffingSheetPreviewCommand}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                        Text="Статус"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        FontWeight="SemiBold"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>

                <Border Grid.Column="2"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,6"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Записей:"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Records.Count}"
                           Margin="8,0,0,0"
                           FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>


        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid Style="{StaticResource AppDataGridStyle}"
                      ItemsSource="{Binding Records}"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserSortColumns="True"
                      HeadersVisibility="All"
                      RowHeaderWidth="44"
                      LoadingRow="RecordsGrid_LoadingRow"
                      Sorting="RecordsGrid_Sorting">

                <DataGrid.RowHeaderStyle>
                    <Style TargetType="{x:Type DataGridRowHeader}">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </DataGrid.RowHeaderStyle>

            </DataGrid>


        </Border>
    </Grid>
</Window>
