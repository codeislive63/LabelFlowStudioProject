<ui:FluentWindow x:Class="LabelFlowStudio.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="LabelFlowStudio"
                 Width="1280"
                 Height="820"
                 MinWidth="1040"
                 MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource AppBackgroundBrush}"
                 Loaded="MainWindow_Loaded"
                 GotKeyboardFocus="Window_GotKeyboardFocus"
                 PreviewTextInput="Window_PreviewTextInput"
                 PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Height="32"
                     Title="LabelFlowStudio"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True"
                     Background="{DynamicResource ShellHeaderBrush}"
                     BorderBrush="{DynamicResource SurfaceBorderBrush}"
                     BorderThickness="0,0,0,1" />

        <Border Grid.Row="1"
                Background="{DynamicResource ShellHeaderBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Левая часть верхней панели -->
                <Grid Grid.Column="0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center">

                    <!-- На главном экране показываем рабочее действие -->
                    <Button Command="{Binding NavigateToManualCommand}"
        Content="Ручная обработка"
        Margin="8,0,0,0">

                        <Button.Style>
                            <Style TargetType="Button"
               BasedOn="{StaticResource ManualActionButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWorkSectionOpen}"
                             Value="False">
                                        <Setter Property="Visibility"
                            Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- На вложенных экранах вместо неё показываем возврат -->
                    <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility"
                            Value="Visible" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWorkSectionOpen}"
                                     Value="True">
                                        <Setter Property="Visibility"
                                    Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Button Width="36"
                    Height="36"
                    Margin="0,0,10,0"
                    Command="{Binding NavigateToWorkCommand}"
                    Style="{StaticResource ShellIconButtonStyle}"
                    ToolTip="Вернуться на главный экран">
                            <ui:SymbolIcon Symbol="ArrowLeft24" />
                        </Button>

                        <TextBlock VerticalAlignment="Center"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Text="{Binding CurrentSectionTitle}" />
                    </StackPanel>
                </Grid>

                <!-- Правая служебная часть -->
                <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                    <!-- Настройки -->
                    <Button Margin="0,0,10,0"
                ToolTip="Настройки"
                Command="{Binding NavigateToSettingsCommand}">
                        <Button.Style>
                            <Style TargetType="Button"
                       BasedOn="{StaticResource ShellIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsSectionOpen}"
                                     Value="True">
                                        <Setter Property="Background"
                                    Value="{DynamicResource ShellNavigationSelectedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <ui:SymbolIcon Symbol="Settings24" />
                    </Button>

                    <!-- Уведомления -->
                    <Button x:Name="NotificationCenterButton"
                Style="{StaticResource ShellIconButtonStyle}"
                ToolTip="Уведомления"
                Click="NotificationCenterButton_Click">

                        <Grid>
                            <ui:SymbolIcon Symbol="Alert24" />

                            <Border MinWidth="18"
                        Height="18"
                        Padding="4,0"
                        Margin="0,-9,-12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        CornerRadius="9">

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility"
                                    Value="Visible" />

                                        <Setter Property="Background"
                                    Value="{DynamicResource WarningBrush}" />

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Work.UnreadProblemNotificationsCount}"
                                             Value="0">
                                                <Setter Property="Visibility"
                                            Value="Collapsed" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding Work.HasUnreadErrorNotifications}"
                                             Value="True">
                                                <Setter Property="Background"
                                            Value="{DynamicResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <TextBlock Text="{Binding Work.UnreadProblemNotificationsCount}"
                               Foreground="{StaticResource SeverityOnColorBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <ContentControl Grid.Row="2"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Content="{Binding CurrentSectionViewModel}" />

        <Grid Grid.Row="2"
              Panel.ZIndex="80">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Work.IsNotificationCenterOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Button Background="Transparent"
                    BorderThickness="0"
                    Focusable="False"
                    Click="NotificationDrawerBackdrop_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border x:Name="NotificationDrawer"
                    Width="412"
                    MaxHeight="610"
                    Margin="0,12,12,12"
                    Padding="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid DataContext="{Binding Work}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <TextBlock VerticalAlignment="Center"
                                   Text="Уведомления"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <Button HorizontalAlignment="Right"
                                Width="30"
                                Height="30"
                                Style="{StaticResource ShellIconButtonStyle}"
                                ToolTip="Закрыть"
                                Click="NotificationCenterCloseButton_Click">
                            <ui:SymbolIcon Symbol="Dismiss24" />
                        </Button>
                    </Grid>

                    <ComboBox x:Name="NotificationFilterComboBox"
                              Grid.Row="1"
                              Margin="0,0,0,12"
                              SelectedIndex="{Binding NotificationTabIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Только проблемы" />
                        <ComboBoxItem Content="Все события" />
                        <ComboBoxItem Content="Только ошибки" />
                        <ComboBoxItem Content="Только предупреждения" />
                        <ComboBoxItem Content="Успешные операции" />
                    </ComboBox>

                    <ListBox x:Name="NotificationsListBox"
                             Grid.Row="2"
                             MinHeight="180"
                             MaxHeight="390"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemsSource="{Binding FilteredNotificationsView}"
                             SelectedItem="{Binding SelectedNotification, Mode=TwoWay}"
                             SelectionChanged="NotificationsListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"
                                   BasedOn="{StaticResource NotificationListItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AutoLineErrorSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AutoLineErrorBorderBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AutoLineWarningSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AutoLineWarningBorderBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AutoLineSuccessSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AutoLineSuccessBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="58" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Margin="0,1,8,0"
                                                   VerticalAlignment="Top"
                                                   FontSize="18">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="Info24" />
                                                <Setter Property="Foreground" Value="{StaticResource AutoLineNeutralBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Symbol" Value="ErrorCircle24" />
                                                        <Setter Property="Foreground" Value="{StaticResource AutoLineErrorBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                        <Setter Property="Symbol" Value="Warning24" />
                                                        <Setter Property="Foreground" Value="{StaticResource AutoLineWarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                        <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                        <Setter Property="Foreground" Value="{StaticResource AutoLineSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <Border HorizontalAlignment="Left"
                                                Padding="7,2"
                                                CornerRadius="8"
                                                BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource AutoLineNeutralSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AutoLineNeutralBorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AutoLineErrorSoftBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AutoLineErrorBorderBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AutoLineWarningSoftBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AutoLineWarningBorderBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AutoLineSuccessSoftBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AutoLineSuccessBorderBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding CategoryText}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource AutoLineNeutralBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AutoLineErrorBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AutoLineWarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AutoLineSuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding Message}"
                                                   Margin="0,6,0,0"
                                                   MaxHeight="58"
                                                   LineHeight="18"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Message}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right" />
                                        <Ellipse Width="7" Height="7" Margin="0,9,0,0"
                                                 HorizontalAlignment="Right"
                                                 Fill="{DynamicResource AccentBrush}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="3"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.NavigateToJournalCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Click="OpenFullJournal_Click"
                            Style="{StaticResource AutoLineLinkButtonStyle}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Открыть полный журнал событий" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Компактное Fluent-уведомление об успешном сохранении -->
        <Border x:Name="SettingsSavedToast"
                Grid.RowSpan="3"
                Panel.ZIndex="120"
                MinWidth="230"
                MaxWidth="320"
                Height="48"
                Margin="0,0,0,120"
                Padding="16,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"

                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"

                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False">

            <Border.RenderTransform>
                <TranslateTransform x:Name="SettingsSavedToastTranslate"
                            Y="10" />
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                          ShadowDepth="4"
                          Opacity="0.16"
                          Color="#000000" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center">

                <ui:SymbolIcon Width="20"
                       Height="20"
                       VerticalAlignment="Center"
                       FontSize="20"
                       Foreground="{DynamicResource AccentBrush}"
                       Symbol="CheckmarkCircle24" />

                <TextBlock Margin="10,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Text="Настройки сохранены" />
            </StackPanel>
        </Border>

        <ui:ContentDialogHost x:Name="RootContentDialogHost"
                      Grid.RowSpan="3"
                      Panel.ZIndex="100"
                      IsDisableSiblingsEnabled="True" />

        <!-- Обычный Snackbar оставляем только для ошибок -->
        <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                      Grid.RowSpan="3"
                      Panel.ZIndex="110"
                      Margin="0,0,24,24"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom" />
    </Grid>
</ui:FluentWindow>
